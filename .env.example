# Stellar network to connect to: "testnet" | "mainnet"
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the chosen network
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Backend REST API base URL (no trailing slash). When unset, sign-in and
# account deletion fail closed with a configuration error — no relative
# requests are issued against the frontend origin.
# Backend REST API base URL (no trailing slash).
# Google sign-in posts the Google ID token to `${VITE_BACKEND_API_URL}/auth/google`
# with body `{ credential }` and expects a `{ token, user }` response shaped
# like `AuthService.signIn`'s SignInResponse. When unset, both password and
# Google sign-in fail closed with a configuration error.
#
# The Dashboard is fetched from:
#   GET `${VITE_BACKEND_API_URL}/api/dashboard/stats`
#   GET `${VITE_BACKEND_API_URL}/api/dashboard/activity?limit=8`
# with an `Authorization: Bearer <token>` header (the gateway guards all routes),
# expecting `{ data: UserStats }` and `{ data: ActivityItem[] }` respectively.
# When unset, the activity feed falls back to the bundled mock fixture in dev;
# stats surface the error state instead.
#
# The Store purchase flow (issue #12) uses the backend as the sole authority
# on pricing, deduction, and balances — the client never sends a price and
# only renders a wallet the server confirmed:
#   GET  `${VITE_BACKEND_API_URL}/api/store/wallet`
#   POST `${VITE_BACKEND_API_URL}/api/store/purchase`  body `{ itemType, itemId }`
# with an `Authorization: Bearer <token>` header, both returning
# `{ data: { coins, lifelines: { fiftyFifty, callAFriend, audience } } }`.
# When unset, the store renders the last cached per-user wallet (or a zero
# default) and purchases fail closed with a configuration error.
VITE_BACKEND_API_URL=http://localhost:3000

# Deployed Soroban contract address
VITE_CONTRACT_ADDRESS=

# Google OAuth client ID (used by @react-oauth/google). The "Sign in with
# Google" button and the GoogleOAuthProvider are only mounted when this is set.
VITE_GOOGLE_CLIENT_ID=

# GitHub repo used to fetch the contributors carousel (owner/repo format).
# Defaults to Riddlrealm/Mindmint-Frontend when omitted.
VITE_CONTRIBUTORS_REPO=Riddlrealm/Mindmint-Frontend
